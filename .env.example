# Public Supabase project settings (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Exact email address allowed into the VystWorld admin panel
ADMIN_EMAIL=your-admin-email@example.com

# Server-only Supabase service role key. NEVER use NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# YooKassa credentials: get them from your YooKassa merchant dashboard.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/payment/return

# Shared secret between the Minecraft plugin and this website backend.
MINECRAFT_BRIDGE_SECRET=replace-with-a-long-random-secret
