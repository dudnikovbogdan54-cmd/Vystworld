# Public Supabase project settings (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://ywtysiovuvzucfxopusj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_MG0x8rZspC2HBo-tXdQhqA_mZQcA_UC
NEXT_PUBLIC_SITE_URL=https://vystworld.vercel.app
# Cloudflare Turnstile public site key (leave empty until configured in Turnstile + Supabase Auth)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Exact email address allowed into the VystWorld admin panel
ADMIN_EMAIL=your-admin-email@example.com

# Server-only Supabase service role key. Get it from Supabase Dashboard -> Project Settings -> API Keys.
# NEVER put this key in NEXT_PUBLIC_ variables or commit its real value to GitHub.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# YooKassa credentials: get them from your YooKassa merchant dashboard.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://vystworld.vercel.app/payment/return

# Shared secret between the Minecraft plugin and this website backend.
MINECRAFT_BRIDGE_SECRET=replace-with-a-long-random-secret

# CAPTCHA: Turnstile widget is implemented for email login/registration. Set NEXT_PUBLIC_TURNSTILE_SITE_KEY here and in Vercel, then enable CAPTCHA in Supabase Auth with the matching Turnstile secret. Google OAuth, SMTP email confirmation, and password-reset delivery require provider settings in Supabase Dashboard.
